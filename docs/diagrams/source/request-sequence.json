    {
      "dot": "rose",
      "title": "Why a role per transaction",
      "items": [
        "The web login user is NOINHERIT: alone it can read nothing",
        "Each transaction picks one role from a closed list",
        "SET LOCAL settings disappear at commit or rollback"
      ]
    },
    {
      "dot": "emerald",
      "title": "What ready means",
      "items": [
        "The database answers within the pool time-out",
        "Every migration file has been applied",
        "Otherwise 503, with no internal detail in the body"
      ]
