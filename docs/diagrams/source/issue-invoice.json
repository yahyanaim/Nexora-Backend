  "cards": [
    {
      "dot": "rose",
      "title": "No gap, no duplicate",
      "items": [
        "The number comes from a locked sequence row",
        "A rollback gives the number back with everything else",
        "The same Idempotency-Key never issues twice"
      ]
    },
    {
      "dot": "cyan",
      "title": "After commit",
      "items": [
        "Files are built by the worker, not in the request",
        "Each file is stored with its SHA-256 hash",
        "A failed job retries; the invoice stays issued"
      ]
    }
  ]
