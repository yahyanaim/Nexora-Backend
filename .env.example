# Web process. Only apps/server/src/config reads these (ARC-04).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
# Required in production: at least 32 random characters.
SESSION_SECRET=
# The web login user (NOINHERIT member of the nx_* roles); required in production.
DATABASE_URL=
# nx_owner: only for npm run db:migrate.
MIGRATION_DATABASE_URL=
# Database tests (superuser URL of a PostgreSQL 16 server); see docs/DATABASE.md.
TEST_DATABASE_ADMIN_URL=
